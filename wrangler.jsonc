{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sa-lawn-website",
	"main": "server/worker.ts",
	"compatibility_date": "2026-05-15",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": true
	},
	"d1_databases": [
  {
    "binding": "DB",
    "database_name": "sa-lawn-care",
    "database_id": "7262ad2d-a788-4872-aa1e-295f3a6326c1",
    "migrations_dir": "migrations"
  }
],
	"vars": {
		"APP_URL": "https://sa-lawn-website.carrasquilla-nicholas.workers.dev",
		"GOOGLE_CALENDAR_ID": "primary",
		"EMAIL_FROM": "S&A Lawn Care <bookings@your-domain.com>"
	},
	"triggers": {
		"crons": [
			"*/5 * * * *"
		]
	},
	"observability": {
		"enabled": true
	}
}