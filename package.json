{
  "name": "sa-lawn-care",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev --local --port 8787",
    "build": "tsc --noEmit && vite build",
    "preview": "wrangler dev --local --port 8787",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "db:local": "wrangler d1 migrations apply sa-lawn-care --local",
    "db:remote": "wrangler d1 migrations apply sa-lawn-care --remote",
    "deploy": "npm run build && wrangler deploy",
    "watch": "vite build --watch"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "1.31.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "packageManager": "pnpm@11.25.0"
}
